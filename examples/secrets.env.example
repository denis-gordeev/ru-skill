#
# Значения учётных данных для legacy-совместимых навыков.
# `KSKILL_PROXY_BASE_URL` намеренно исключён из шаблона по умолчанию:
# это необязательное переопределение адреса для `fine-dust-location`, а не секрет.
#
KSKILL_SRT_ID=replace-me
KSKILL_SRT_PASSWORD=replace-me
KSKILL_KTX_ID=replace-me
KSKILL_KTX_PASSWORD=replace-me
SEOUL_OPEN_API_KEY=replace-me
AIR_KOREA_OPEN_API_KEY=replace-me

# Необязательное переопределение адреса для fine-dust-location; раскомментируйте,
# только если нужно заменить опубликованный совместимый proxy endpoint.
# KSKILL_PROXY_BASE_URL=https://k-skill-proxy.nomadamas.org
