#
# Credential values for legacy-compatible skills.
# `KSKILL_PROXY_BASE_URL` is intentionally omitted from the default template:
# it is an optional endpoint override for `fine-dust-location`, not a secret.
#
KSKILL_SRT_ID=replace-me
KSKILL_SRT_PASSWORD=replace-me
KSKILL_KTX_ID=replace-me
KSKILL_KTX_PASSWORD=replace-me
SEOUL_OPEN_API_KEY=replace-me
AIR_KOREA_OPEN_API_KEY=replace-me

# Optional config override for fine-dust-location; uncomment only if you need
# to replace the published compatibility proxy endpoint.
# KSKILL_PROXY_BASE_URL=https://k-skill-proxy.nomadamas.org
